# ──────────────────────────────────────────────────────────
# ShieldScope — environment example
# DO NOT commit a real .env file with actual API keys.
# ──────────────────────────────────────────────────────────

# Webacy / DD.xyz API key (REQUIRED for live scanning)
# Get it at https://docs.webacy.com after grant approval
WEBACITY_API_KEY=

# Environment: "development" or "production"
ENVIRONMENT=development

# Cookie security (True = HTTPS-only cookies in production)
COOKIE_SECURE=true
